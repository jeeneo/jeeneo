desc: ViPER Bass + Clarity
author: VipersAudio
tags: clarity treble presence enhance viper bass subwoofer

dClarityMode:0<0,2,1{Natural,Ozone,xHiFi}>Clarity mode
dStrength:50<0,100,1>Clarity strength (×)
dBassMode:0<0,2,1{Natural Bass,Pure Bass+,Subwoofer}>Bass mode
dFrequency:60<20,300,1>Frequency (Hz)
dBassGain:50<0,100,1>Bass gain (×)

@init
dClarityMode = 0;
dStrength    = 65;
dBassMode    = 0;
dFrequency   = 115;
dBassGain    = 60;

ns_freq = srate * 0.5 - 1000.0;
ns_t    = tan($PI * ns_freq / srate);
ns_b0   = ns_t / (1.0 + ns_t);
ns_b1   = ns_b0;
ns_a1   = (1.0 - ns_t) / (1.0 + ns_t);

ns_prevL = 0.0;  ns_prevR = 0.0;
ns_inL   = 0.0;  ns_inR   = 0.0;

function HS_Calc(freq_hz gain_lin) (
    hs_dBg  = 20.0 * log10(gain_lin);
    hs_x    = 2.0 * $PI * freq_hz / srate;
    hs_sinx = sin(hs_x);
    hs_cosx = cos(hs_x);
    hs_y    = exp(hs_dBg * log(10.0) / 40.0);
    hs_z    = sqrt(hs_y * 2.0) * hs_sinx;
    hs_aa   = (hs_y - 1.0) * hs_cosx;
    hs_b    = (hs_y + 1.0) - hs_aa;
    hs_c    = hs_z + hs_b;
    hs_d    = (hs_y + 1.0) * hs_cosx;
    hs_e    = (hs_y + 1.0) + hs_aa;
    hs_ff   = (hs_y - 1.0) - hs_d;
    hs_a0i  = 1.0 / hs_c;
    hs_a1c  = hs_ff * 2.0;
    hs_a2c  = hs_b - hs_z;
    hs_b0c  = (hs_e + hs_z) * hs_y;
    hs_b1c  = -hs_y * 2.0 * ((hs_y - 1.0) + hs_d);
    hs_b2c  = (hs_e - hs_z) * hs_y;
);

HS_Calc(8250.0, dStrength + 1.0);

hs_x1L = 0.0; hs_x2L = 0.0; hs_y1L = 0.0; hs_y2L = 0.0;
hs_x1R = 0.0; hs_x2R = 0.0; hs_y1R = 0.0; hs_y2R = 0.0;

prev_dStrength = -1;

xh_lp_t   = tan($PI * 120.0 / srate);
xh_lp_b0  = xh_lp_t / (1.0 + xh_lp_t);
xh_lp_b1  = xh_lp_b0;
xh_lp_a1  = (1.0 - xh_lp_t) / (1.0 + xh_lp_t);

xh_hp_t   = tan($PI * 1200.0 / srate);
xh_hp_b0  =  1.0 / (1.0 + xh_hp_t);
xh_hp_b1  = -xh_hp_b0;
xh_hp_a1  = (1.0 - xh_hp_t) / (1.0 + xh_hp_t);

xh_bplp_t  = tan($PI * 1200.0 / srate);
xh_bplp_b0 = xh_bplp_t / (1.0 + xh_bplp_t);
xh_bplp_b1 = xh_bplp_b0;
xh_bplp_a1 = (1.0 - xh_bplp_t) / (1.0 + xh_bplp_t);

xh_bphp_t  = tan($PI * 120.0 / srate);
xh_bphp_b0 =  1.0 / (1.0 + xh_bphp_t);
xh_bphp_b1 = -xh_bphp_b0;
xh_bphp_a1 = (1.0 - xh_bphp_t) / (1.0 + xh_bphp_t);

xh_lp_pL  = 0.0; xh_lp_pR  = 0.0;
xh_hp1_pL = 0.0; xh_hp1_pR = 0.0;
xh_hp2_pL = 0.0; xh_hp2_pR = 0.0;
xh_hp3_pL = 0.0; xh_hp3_pR = 0.0;
xh_bplp1_pL = 0.0; xh_bplp1_pR = 0.0;
xh_bplp2_pL = 0.0; xh_bplp2_pR = 0.0;
xh_bplp3_pL = 0.0; xh_bplp3_pR = 0.0;
xh_bphp1_pL = 0.0; xh_bphp1_pR = 0.0;
xh_bphp2_pL = 0.0; xh_bphp2_pR = 0.0;
xh_bphp3_pL = 0.0; xh_bphp3_pR = 0.0;

xh_bpDlyLen = floor(srate / 400);
xh_lpDlyLen = floor(srate / 200);
xh_bpDL = 0.0;
xh_bpDR = xh_bpDL + FIRInit(xh_bpDL, xh_bpDlyLen);
xh_lpDL = xh_bpDR + FIRInit(xh_bpDR, xh_lpDlyLen);
xh_lpDR = xh_lpDL + FIRInit(xh_lpDL, xh_lpDlyLen);
xh_bpPos = 0;
xh_lpPos = 0;
i = 0;
loop(xh_bpDlyLen, xh_bpDL[i] = 0.0; xh_bpDR[i] = 0.0; i += 1;);
i = 0;
loop(xh_lpDlyLen, xh_lpDL[i] = 0.0; xh_lpDR[i] = 0.0; i += 1;);

antiPop      = 0.0;
antiPopInc   = 1.0 / srate;
prevBassMode = -1;
prevSpeaker  = -1;
prevGain     = -1;

function BQ_LPF(freq sr Q) (
    bq_omega = 2.0 * $PI * freq / sr;
    bq_sinO  = sin(bq_omega);
    bq_cosO  = cos(bq_omega);
    bq_alpha = bq_sinO / (Q + Q);
    bq_a0    = 1.0 + bq_alpha;
    bq_a1out = -(-2.0 * bq_cosO / bq_a0);
    bq_a2out = -((1.0 - bq_alpha) / bq_a0);
    bq_b0out = ((1.0 - bq_cosO) / 2.0) / bq_a0;
    bq_b1out = (1.0 - bq_cosO) / bq_a0;
    bq_b2out = bq_b0out;
);

function MB_PEAK_sinh(freq sr gainAmp Q) (
    mb_gain  = pow(10.0, gainAmp / 40.0);
    mb_omega = 2.0 * $PI * freq / sr;
    mb_sinO  = sin(mb_omega);
    mb_cosO  = cos(mb_omega);
    mb_y     = sinh(Q * log(2.0) * mb_omega / 2.0 / mb_sinO) * mb_sinO;
    mb_a0    = 1.0 + mb_y / mb_gain;
    mb_a1out = -(-2.0 * mb_cosO / mb_a0);
    mb_a2out = -((1.0 - mb_y / mb_gain) / mb_a0);
    mb_b0out = (1.0 + mb_y * mb_gain) / mb_a0;
    mb_b1out = (-2.0 * mb_cosO) / mb_a0;
    mb_b2out = (1.0 - mb_y * mb_gain) / mb_a0;
);

function MB_LPF(freq sr Q) (
    mb_omega = 2.0 * $PI * freq / sr;
    mb_sinO  = sin(mb_omega);
    mb_cosO  = cos(mb_omega);
    mb_y     = mb_sinO / (Q + Q);
    mb_a0    = 1.0 + mb_y;
    mb_a1out = -(-2.0 * mb_cosO / mb_a0);
    mb_a2out = -((1.0 - mb_y) / mb_a0);
    mb_b0out = ((1.0 - mb_cosO) / 2.0) / mb_a0;
    mb_b1out = (1.0 - mb_cosO) / mb_a0;
    mb_b2out = mb_b0out;
);

BQ_LPF(dFrequency, srate, 0.53);
nb_a1 = bq_a1out; nb_a2 = bq_a2out;
nb_b0 = bq_b0out; nb_b1 = bq_b1out; nb_b2 = bq_b2out;
nb_x1L = 0.0; nb_x2L = 0.0; nb_y1L = 0.0; nb_y2L = 0.0;
nb_x1R = 0.0; nb_x2R = 0.0; nb_y1R = 0.0; nb_y2R = 0.0;

pb_coeffs = 0;
pb_hLen = importFLTFromStr(
    "-0.002339,-0.002073,-0.001940,-0.001675,-0.001515,-0.001329,-0.001223,"
    "-0.001037,-0.000904,-0.000851,-0.000532,-0.000851,-0.000106,-0.001010,"
    "0.000558,-0.001435,0.001302,-0.001967,0.002259,-0.002605,0.003216,"
    "-0.003562,0.004784,-0.005475,0.007655,-0.008506,0.017622,-0.024639,"
    "0.028679,-0.017303,-0.032507,0.623321,0.184702,-0.166867,0.025729,"
    "-0.078490,-0.015735,-0.041199,-0.023151,-0.031524,-0.020121,-0.024985,"
    "-0.017303,-0.019616,-0.015018,-0.015204,-0.012838,-0.011881,-0.010951,"
    "-0.009516,-0.009090,-0.007788,-0.007442,-0.006353,-0.006087,-0.005183,"
    "-0.004970,-0.004253,-0.003987,-0.003482,-0.003216,-0.002871,-0.002578",
    pb_coeffs);

pb_firL = pb_coeffs + pb_hLen;
pb_firR = pb_firL + FIRInit(pb_firL, pb_hLen);
pb_a1 = nb_a1; pb_a2 = nb_a2;
pb_b0 = nb_b0; pb_b1 = nb_b1; pb_b2 = nb_b2;
pb_x1L = 0.0; pb_x2L = 0.0; pb_y1L = 0.0; pb_y2L = 0.0;
pb_x1R = 0.0; pb_x2R = 0.0; pb_y1R = 0.0; pb_y2R = 0.0;

pb_delay  = pb_firR + FIRInit(pb_firR, pb_hLen);
pb_delayR = pb_delay + 63;
pb_dpos   = 0;
i = 0;
loop(63, pb_delay[i] = 0.0; pb_delayR[i] = 0.0; i += 1;);

sw_prevGain = -999.0;

function SW_Recompute(bf) (
    sw_gainDb     = bf * 2.5;
    sw_gain_dB    = 20.0 * log10(sw_gainDb);
    sw_gainLow_dB = 20.0 * log10(sw_gainDb / 8.0);

    MB_PEAK_sinh(44.0, srate, sw_gain_dB, 0.75);
    sw_p44_a1 = mb_a1out; sw_p44_a2 = mb_a2out;
    sw_p44_b0 = mb_b0out; sw_p44_b1 = mb_b1out; sw_p44_b2 = mb_b2out;

    MB_PEAK_sinh(80.0, srate, sw_gainLow_dB, 0.2);
    sw_p80_a1 = mb_a1out; sw_p80_a2 = mb_a2out;
    sw_p80_b0 = mb_b0out; sw_p80_b1 = mb_b1out; sw_p80_b2 = mb_b2out;

    MB_LPF(380.0, srate, 0.6);
    sw_lp_a1 = mb_a1out; sw_lp_a2 = mb_a2out;
    sw_lp_b0 = mb_b0out; sw_lp_b1 = mb_b1out; sw_lp_b2 = mb_b2out;
);

SW_Recompute(dBassGain);

sw_p44_x1L = 0.0; sw_p44_x2L = 0.0; sw_p44_y1L = 0.0; sw_p44_y2L = 0.0;
sw_p44_x1R = 0.0; sw_p44_x2R = 0.0; sw_p44_y1R = 0.0; sw_p44_y2R = 0.0;
sw_p80_x1L = 0.0; sw_p80_x2L = 0.0; sw_p80_y1L = 0.0; sw_p80_y2L = 0.0;
sw_p80_x1R = 0.0; sw_p80_x2R = 0.0; sw_p80_y1R = 0.0; sw_p80_y2R = 0.0;
sw_lp_x1L = 0.0; sw_lp_x2L = 0.0; sw_lp_y1L = 0.0; sw_lp_y2L = 0.0;
sw_lp_x1R = 0.0; sw_lp_x2R = 0.0; sw_lp_y1R = 0.0; sw_lp_y2R = 0.0;

@sample
clarityAmount = dStrength * 0.05;
bassFactor    = dBassGain * 0.06;

dFrequency != prevSpeaker ? (
    prevSpeaker = dFrequency;

    BQ_LPF(dFrequency, srate, 0.53);
    nb_a1 = bq_a1out; nb_a2 = bq_a2out;
    nb_b0 = bq_b0out; nb_b1 = bq_b1out; nb_b2 = bq_b2out;

    pb_a1 = nb_a1; pb_a2 = nb_a2;
    pb_b0 = nb_b0; pb_b1 = nb_b1; pb_b2 = nb_b2;
);

dBassMode != prevBassMode ? (
    antiPop       = 0.0;
    prevBassMode  = dBassMode;

    BQ_LPF(dFrequency, srate, 0.53);
    nb_a1 = bq_a1out; nb_a2 = bq_a2out;
    nb_b0 = bq_b0out; nb_b1 = bq_b1out; nb_b2 = bq_b2out;
    nb_x1L = 0.0; nb_x2L = 0.0; nb_y1L = 0.0; nb_y2L = 0.0;
    nb_x1R = 0.0; nb_x2R = 0.0; nb_y1R = 0.0; nb_y2R = 0.0;

    pb_a1 = nb_a1; pb_a2 = nb_a2;
    pb_b0 = nb_b0; pb_b1 = nb_b1; pb_b2 = nb_b2;
    pb_x1L = 0.0; pb_x2L = 0.0; pb_y1L = 0.0; pb_y2L = 0.0;
    pb_x1R = 0.0; pb_x2R = 0.0; pb_y1R = 0.0; pb_y2R = 0.0;

    FIRInit(pb_firL, pb_hLen);
    FIRInit(pb_firR, pb_hLen);
    i = 0; loop(63, pb_delay[i] = 0.0; pb_delayR[i] = 0.0; i += 1;);
    pb_dpos = 0;

    sw_p44_x1L = 0.0; sw_p44_x2L = 0.0; sw_p44_y1L = 0.0; sw_p44_y2L = 0.0;
    sw_p44_x1R = 0.0; sw_p44_x2R = 0.0; sw_p44_y1R = 0.0; sw_p44_y2R = 0.0;
    sw_p80_x1L = 0.0; sw_p80_x2L = 0.0; sw_p80_y1L = 0.0; sw_p80_y2L = 0.0;
    sw_p80_x1R = 0.0; sw_p80_x2R = 0.0; sw_p80_y1R = 0.0; sw_p80_y2R = 0.0;
    sw_lp_x1L = 0.0; sw_lp_x2L = 0.0; sw_lp_y1L = 0.0; sw_lp_y2L = 0.0;
    sw_lp_x1R = 0.0; sw_lp_x2R = 0.0; sw_lp_y1R = 0.0; sw_lp_y2R = 0.0;
    sw_prevGain = -999.0;
);

spl0 *= antiPop;
spl1 *= antiPop;
antiPop < 1.0 ? (
    antiPop += antiPopInc;
    antiPop > 1.0 ? antiPop = 1.0;
);

(dBassMode == 0) ? (
    nb_outL = spl0 * nb_b0 + nb_x1L * nb_b1 + nb_x2L * nb_b2
              + nb_y1L * nb_a1 + nb_y2L * nb_a2;
    nb_x2L = nb_x1L; nb_x1L = spl0;
    nb_y2L = nb_y1L; nb_y1L = nb_outL;

    nb_outR = spl1 * nb_b0 + nb_x1R * nb_b1 + nb_x2R * nb_b2
              + nb_y1R * nb_a1 + nb_y2R * nb_a2;
    nb_x2R = nb_x1R; nb_x1R = spl1;
    nb_y2R = nb_y1R; nb_y1R = nb_outR;

    spl0 += nb_outL * bassFactor;
    spl1 += nb_outR * bassFactor;

) : (dBassMode == 1) ? (
    pb_lpL = spl0 * pb_b0 + pb_x1L * pb_b1 + pb_x2L * pb_b2
             + pb_y1L * pb_a1 + pb_y2L * pb_a2;
    pb_x2L = pb_x1L; pb_x1L = spl0;
    pb_y2L = pb_y1L; pb_y1L = pb_lpL;

    pb_lpR = spl1 * pb_b0 + pb_x1R * pb_b1 + pb_x2R * pb_b2
             + pb_y1R * pb_a1 + pb_y2R * pb_a2;
    pb_x2R = pb_x1R; pb_x1R = spl1;
    pb_y2R = pb_y1R; pb_y1R = pb_lpR;

    pb_delayedL = pb_delay[pb_dpos];
    pb_delayedR = pb_delayR[pb_dpos];

    pb_delay[pb_dpos]  = pb_lpL;
    pb_delayR[pb_dpos] = pb_lpR;
    pb_dpos = (pb_dpos + 1) % 63;

    spl0 = FIRProcess(pb_firL, spl0, pb_coeffs);
    spl1 = FIRProcess(pb_firR, spl1, pb_coeffs);

    spl0 += pb_delayedL * bassFactor;
    spl1 += pb_delayedR * bassFactor;

) : (
    dBassGain != sw_prevGain && dBassGain > 0.0 ? (
        SW_Recompute(dBassGain);
        sw_prevGain = dBassGain;
    );

    sw_tmpL = spl0 * sw_p44_b0 + sw_p44_x1L * sw_p44_b1 + sw_p44_x2L * sw_p44_b2
              + sw_p44_y1L * sw_p44_a1 + sw_p44_y2L * sw_p44_a2;
    sw_p44_x2L = sw_p44_x1L; sw_p44_x1L = spl0;
    sw_p44_y2L = sw_p44_y1L; sw_p44_y1L = sw_tmpL;

    sw_tmpL = sw_tmpL * sw_p80_b0 + sw_p80_x1L * sw_p80_b1 + sw_p80_x2L * sw_p80_b2
              + sw_p80_y1L * sw_p80_a1 + sw_p80_y2L * sw_p80_a2;
    sw_p80_x2L = sw_p80_x1L; sw_p80_x1L = sw_p44_y1L;
    sw_p80_y2L = sw_p80_y1L; sw_p80_y1L = sw_tmpL;

    sw_diffL = sw_tmpL - spl0;

    sw_tmpL = sw_diffL * sw_lp_b0 + sw_lp_x1L * sw_lp_b1 + sw_lp_x2L * sw_lp_b2
              + sw_lp_y1L * sw_lp_a1 + sw_lp_y2L * sw_lp_a2;
    sw_lp_x2L = sw_lp_x1L; sw_lp_x1L = sw_diffL;
    sw_lp_y2L = sw_lp_y1L; sw_lp_y1L = sw_tmpL;

    sw_tmpR = spl1 * sw_p44_b0 + sw_p44_x1R * sw_p44_b1 + sw_p44_x2R * sw_p44_b2
              + sw_p44_y1R * sw_p44_a1 + sw_p44_y2R * sw_p44_a2;
    sw_p44_x2R = sw_p44_x1R; sw_p44_x1R = spl1;
    sw_p44_y2R = sw_p44_y1R; sw_p44_y1R = sw_tmpR;

    sw_tmpR = sw_tmpR * sw_p80_b0 + sw_p80_x1R * sw_p80_b1 + sw_p80_x2R * sw_p80_b2
              + sw_p80_y1R * sw_p80_a1 + sw_p80_y2R * sw_p80_a2;
    sw_p80_x2R = sw_p80_x1R; sw_p80_x1R = sw_p44_y1R;
    sw_p80_y2R = sw_p80_y1R; sw_p80_y1R = sw_tmpR;

    sw_diffR = sw_tmpR - spl1;

    sw_tmpR = sw_diffR * sw_lp_b0 + sw_lp_x1R * sw_lp_b1 + sw_lp_x2R * sw_lp_b2
              + sw_lp_y1R * sw_lp_a1 + sw_lp_y2R * sw_lp_a2;
    sw_lp_x2R = sw_lp_x1R; sw_lp_x1R = sw_diffR;
    sw_lp_y2R = sw_lp_y1R; sw_lp_y1R = sw_tmpR;

    spl0 = spl0 * 0.5 + sw_tmpL * 0.6;
    spl1 = spl1 * 0.5 + sw_tmpR * 0.6;
);

(dClarityMode == 0) ? (
    ns_diffL = (spl0 - ns_inL) * clarityAmount;
    ns_inL   = spl0;
    ns_sL    = spl0 + ns_diffL;
    ns_hL    = ns_sL * ns_b1;
    ns_outL  = ns_prevL + ns_sL * ns_b0;
    ns_prevL = ns_outL * ns_a1 + ns_hL;

    ns_diffR = (spl1 - ns_inR) * clarityAmount;
    ns_inR   = spl1;
    ns_sR    = spl1 + ns_diffR;
    ns_hR    = ns_sR * ns_b1;
    ns_outR  = ns_prevR + ns_sR * ns_b0;
    ns_prevR = ns_outR * ns_a1 + ns_hR;

    spl0 = ns_outL;
    spl1 = ns_outR;

) : (dClarityMode == 1) ? (
    dStrength != prev_dStrength ? (
        HS_Calc(8250.0, clarityAmount + 1.0);
        prev_dStrength = dStrength;
    );

    hs_oL  = (hs_x1L * hs_b1c + spl0 * hs_b0c + hs_b2c * hs_x2L
              - hs_y1L * hs_a1c - hs_a2c * hs_y2L) * hs_a0i;
    hs_y2L = hs_y1L; hs_y1L = hs_oL;
    hs_x2L = hs_x1L; hs_x1L = spl0;

    hs_oR  = (hs_x1R * hs_b1c + spl1 * hs_b0c + hs_b2c * hs_x2R
              - hs_y1R * hs_a1c - hs_a2c * hs_y2R) * hs_a0i;
    hs_y2R = hs_y1R; hs_y1R = hs_oR;
    hs_x2R = hs_x1R; hs_x1R = spl1;

    spl0 = hs_oL;
    spl1 = hs_oR;

) : (
    xh_gain = clarityAmount + 1.0;

    xh_h     = spl0 * xh_lp_b1;
    xh_lpL   = xh_lp_pL + spl0 * xh_lp_b0;
    xh_lp_pL = xh_lpL * xh_lp_a1 + xh_h;

    xh_h      = spl0 * xh_hp_b1;
    xh_v      = xh_hp1_pL + spl0 * xh_hp_b0;
    xh_hp1_pL = xh_v * xh_hp_a1 + xh_h;
    xh_h      = xh_v * xh_hp_b1;
    xh_v2     = xh_hp2_pL + xh_v * xh_hp_b0;
    xh_hp2_pL = xh_v2 * xh_hp_a1 + xh_h;
    xh_h      = xh_v2 * xh_hp_b1;
    xh_hpL    = xh_hp3_pL + xh_v2 * xh_hp_b0;
    xh_hp3_pL = xh_hpL * xh_hp_a1 + xh_h;

    xh_h        = spl0 * xh_bplp_b1;
    xh_v        = xh_bplp1_pL + spl0 * xh_bplp_b0;
    xh_bplp1_pL = xh_v * xh_bplp_a1 + xh_h;
    xh_h        = xh_v * xh_bplp_b1;
    xh_v2       = xh_bplp2_pL + xh_v * xh_bplp_b0;
    xh_bplp2_pL = xh_v2 * xh_bplp_a1 + xh_h;
    xh_h        = xh_v2 * xh_bplp_b1;
    xh_v3       = xh_bplp3_pL + xh_v2 * xh_bplp_b0;
    xh_bplp3_pL = xh_v3 * xh_bplp_a1 + xh_h;
    xh_h        = xh_v3 * xh_bphp_b1;
    xh_v        = xh_bphp1_pL + xh_v3 * xh_bphp_b0;
    xh_bphp1_pL = xh_v * xh_bphp_a1 + xh_h;
    xh_h        = xh_v * xh_bphp_b1;
    xh_v2       = xh_bphp2_pL + xh_v * xh_bphp_b0;
    xh_bphp2_pL = xh_v2 * xh_bphp_a1 + xh_h;
    xh_h        = xh_v2 * xh_bphp_b1;
    xh_bpL      = xh_bphp3_pL + xh_v2 * xh_bphp_b0;
    xh_bphp3_pL = xh_bpL * xh_bphp_a1 + xh_h;

    xh_lpDly = xh_lpDL[xh_lpPos];
    xh_lpDL[xh_lpPos] = xh_lpL;
    xh_lpPos = (xh_lpPos + 1) % xh_lpDlyLen;

    xh_bpDly = xh_bpDL[xh_bpPos];
    xh_bpDL[xh_bpPos] = xh_bpL;
    xh_bpPos = (xh_bpPos + 1) % xh_bpDlyLen;

    spl0 = xh_hpL * xh_gain * 1.2 + xh_bpDly * xh_gain + xh_lpDly;

    xh_h     = spl1 * xh_lp_b1;
    xh_lpR   = xh_lp_pR + spl1 * xh_lp_b0;
    xh_lp_pR = xh_lpR * xh_lp_a1 + xh_h;

    xh_h      = spl1 * xh_hp_b1;
    xh_v      = xh_hp1_pR + spl1 * xh_hp_b0;
    xh_hp1_pR = xh_v * xh_hp_a1 + xh_h;
    xh_h      = xh_v * xh_hp_b1;
    xh_v2     = xh_hp2_pR + xh_v * xh_hp_b0;
    xh_hp2_pR = xh_v2 * xh_hp_a1 + xh_h;
    xh_h      = xh_v2 * xh_hp_b1;
    xh_hpR    = xh_hp3_pR + xh_v2 * xh_hp_b0;
    xh_hp3_pR = xh_hpR * xh_hp_a1 + xh_h;

    xh_h        = spl1 * xh_bplp_b1;
    xh_v        = xh_bplp1_pR + spl1 * xh_bplp_b0;
    xh_bplp1_pR = xh_v * xh_bplp_a1 + xh_h;
    xh_h        = xh_v * xh_bplp_b1;
    xh_v2       = xh_bplp2_pR + xh_v * xh_bplp_b0;
    xh_bplp2_pR = xh_v2 * xh_bplp_a1 + xh_h;
    xh_h        = xh_v2 * xh_bplp_b1;
    xh_v3       = xh_bplp3_pR + xh_v2 * xh_bplp_b0;
    xh_bplp3_pR = xh_v3 * xh_bplp_a1 + xh_h;
    xh_h        = xh_v3 * xh_bphp_b1;
    xh_v        = xh_bphp1_pR + xh_v3 * xh_bphp_b0;
    xh_bphp1_pR = xh_v * xh_bphp_a1 + xh_h;
    xh_h        = xh_v * xh_bphp_b1;
    xh_v2       = xh_bphp2_pR + xh_v * xh_bphp_b0;
    xh_bphp2_pR = xh_v2 * xh_bphp_a1 + xh_h;
    xh_h        = xh_v2 * xh_bphp_b1;
    xh_bpR      = xh_bphp3_pR + xh_v2 * xh_bphp_b0;
    xh_bphp3_pR = xh_bpR * xh_bphp_a1 + xh_h;

    xh_lpDlyR = xh_lpDR[xh_lpPos];
    xh_lpDR[xh_lpPos] = xh_lpR;
    xh_lpPos = (xh_lpPos + 1) % xh_lpDlyLen;

    xh_bpDlyR = xh_bpDR[xh_bpPos];
    xh_bpDR[xh_bpPos] = xh_bpR;
    xh_bpPos = (xh_bpPos + 1) % xh_bpDlyLen;

    spl1 = xh_hpR * xh_gain * 1.2 + xh_bpDlyR * xh_gain + xh_lpDlyR;
);

xh_bpDR=xh_bpDL+FIRInit(xh_bpDL,xh_bpDlyLen);
xh_lpDL=xh_bpDR+FIRInit(xh_bpDR,xh_lpDlyLen);
xh_lpDR=xh_lpDL+FIRInit(xh_lpDL,xh_lpDlyLen);
xh_bpPos=0; xh_lpPos=0;
i=0; loop(xh_bpDlyLen,xh_bpDL[i]=0; xh_bpDR[i]=0; i+=1;);
i=0; loop(xh_lpDlyLen,xh_lpDL[i]=0; xh_lpDR[i]=0; i+=1;);
// Keep setup scratch above all clarity delay buffers, including at 192 kHz.
hp_temp=xh_lpDR+xh_lpDlyLen+16;
Bass_coeff_init();

// Base-256 digits keep every limb product and accumulator exact in float32.
// Signed high digit is used for multiplication, with modular 64-bit carries.
function I_copy(dst src) ( memcpy(dst,src,4); );
function I_from_float(dst v) local(q i) (
    // ViPER internal PCM16 << 9 corresponds to float full scale 2^24.
    // Clamp input to the int32 range; truncation, not saturation, occurs inside DSP.
    v=min(127.99999237060547,max(-128,v))*16777216;
    v>=0 ? v=floor(v) : v=ceil(v);
    i=0; loop(4, q=floor(v/256); dst[i]=v-q*256; v=q; i+=1;);
);
function I_to_float(src) local(d0 d1 d2 d3 carry t negative) (
    // Convert magnitude high-to-low: the first 24 bits are exact, so only
    // the final byte addition rounds. Avoid cancellation near zero for negatives.
    negative=src[3]>=128;
    d0=src[0]; d1=src[1]; d2=src[2]; d3=src[3];
    negative ? (
        t=256-d0; carry=floor(t/256); d0=t-carry*256;
        t=255-d1+carry; carry=floor(t/256); d1=t-carry*256;
        t=255-d2+carry; carry=floor(t/256); d2=t-carry*256;
        d3=255-d3+carry;
    );
    t=(((d3*256+d2)*256+d1)*256+d0)/16777216;
    negative ? -t : t;
);
function I_add(dst a b subtract) local(i c t q) (
    i=0; c=0; loop(4,
        t=a[i]+(subtract ? -b[i] : b[i])+c;
        q=floor(t/256); dst[i]=t-q*256; c=q; i+=1;
    );
);
function I_half(dst src) local(i carry t) (
    i=3; carry=src[3]>=128 ? 1 : 0;
    loop(4, t=src[i]; dst[i]=floor(t/2)+carry*128; carry=t%2; i-=1;);
);
function I_accum(a b) local(i j av bv) (
    i=0; loop(4,
        av=a[i]; i==3 && av>=128 ? av-=256;
        j=0; loop(4,
            bv=b[j]; j==3 && bv>=128 ? bv-=256;
            int_acc[i+j]+=av*bv; j+=1;
        ); i+=1;
    );
);
function I_shift24(dst) local(i q t) (
    i=0; loop(7,
        t=int_acc[i]; q=floor(t/256); int_acc[i]=t-q*256;
        int_acc[i+1]+=q; i+=1;
    );
    dst[0]=int_acc[3]; dst[1]=int_acc[4]; dst[2]=int_acc[5]; dst[3]=int_acc[6];
);
function I_mul(dst a b) (
    memset(int_acc,0,8); I_accum(a,b); I_shift24(dst);
);
function I_bq(c st x dst) (
    memset(int_acc,0,8);
    I_accum(x,c); I_accum(st,c+4); I_accum(st+4,c+8);
    I_accum(st+8,c+12); I_accum(st+12,c+16);
    I_copy(st+4,st); I_copy(st,x); I_copy(st+12,st+8);
    I_shift24(dst); I_copy(st+8,dst);
);
function Bass_reset() (
    Fixed_coeff(dFrequency,srate); memset(bass_lp_state,0,16);
    Sub_coeff(); memset(bass_firL,0,256); memset(bass_firR,0,256);
    memset(bass_delay,0,256); bass_pos=0; bass_fade=0;
);
function Bass_process() local(i j tap) (
    I_from_float(int_L,spl0); I_from_float(int_R,spl1);
    // Fade is representable exactly up to 2^24. Split it before multiplication.
    I_from_float(int_U,bass_fade/16777216);
    I_mul(int_L,int_L,int_U); I_mul(int_R,int_R,int_U);
    bass_fade=min(16777216,bass_fade+bass_fade_step);
    dBassMode==0 || dBassMode==1 ? (
        I_add(int_m,int_L,int_R,0); I_half(int_m,int_m);
        I_bq(bass_lp,bass_lp_state,int_m,int_v);
        dBassMode==0 ? (
            I_mul(int_v,int_v,int_gain);
            I_add(int_L,int_L,int_v,0); I_add(int_R,int_R,int_v,0);
        ) : (
            I_copy(int_dl,bass_delay+bass_pos*4); I_copy(bass_delay+bass_pos*4,int_v);
            I_copy(bass_firL+bass_pos*4,int_L); I_copy(bass_firR+bass_pos*4,int_R);
            memset(int_fl,0,4); memset(int_fr,0,4); i=0; j=bass_pos;
            loop(64,
                tap=bass_taps+i*4;
                I_mul(int_v,bass_firL+j*4,tap); I_add(int_fl,int_fl,int_v,0);
                I_mul(int_v,bass_firR+j*4,tap); I_add(int_fr,int_fr,int_v,0);
                i+=1; j-=1; j<0 ? j=63;
            );
            bass_pos=(bass_pos+1)%64; I_mul(int_dl,int_dl,int_gain);
            I_add(int_L,int_fl,int_dl,0); I_add(int_R,int_fr,int_dl,0);
        );
    ) : (
        I_bq(bass_p44,bass_sub_state,int_L,int_v);
        I_bq(bass_p80,bass_sub_state+16,int_v,int_v);
        I_add(int_v,int_v,int_L,1);
        I_bq(bass_swlp,bass_sub_state+32,int_v,int_v);
        I_mul(int_v,int_v,int_mix); I_half(int_L,int_L); I_add(int_L,int_L,int_v,0);
        I_bq(bass_p44,bass_sub_state+48,int_R,int_v);
        I_bq(bass_p80,bass_sub_state+64,int_v,int_v);
        I_add(int_v,int_v,int_R,1);
        I_bq(bass_swlp,bass_sub_state+80,int_v,int_v);
        I_mul(int_v,int_v,int_mix); I_half(int_R,int_R); I_add(int_R,int_R,int_v,0);
    );
    // Bass-only output before the unchanged floating-point clarity stage.
    spl0=I_to_float(int_L); spl1=I_to_float(int_R);
);

bass_factor=0; prevBassMode=-1; prevSpeaker=-1; prevRate=-1;
int_mix[0]=154; int_mix[1]=153; int_mix[2]=153; int_mix[3]=0;

@sample
// Sliders are dB; decode to official API integers only when they change so
// steady-state processing never evaluates pow().
dStrength!=prevStrengthDb ? (
    prevStrengthDb=dStrength;
    clarityV=(pow(10,dStrength*0.05)-1)*100;
    clarityV=min(450,max(0,clarityV));
    clarityAmount=clarityV*0.009999999776482582;
);
// Evaluate settings in the native setter order: rate, speaker, gain, mode.
srate!=prevRate ? (
    prevRate=srate;
    bass_fade_step=floor(16777216/srate);
    !coeff_integer ? bass_fade_step/=16777216;
    Fixed_coeff(dFrequency,srate);
    memset(bass_lp_state,0,coeff_integer ? 16 : 4); Sub_coeff();
);
dFrequency!=prevSpeaker ? (
    prevSpeaker=dFrequency; Fixed_coeff(dFrequency,srate);
    memset(bass_lp_state,0,coeff_integer ? 16 : 4);
);
dBassGain!=prevBassDb ? (
    prevBassDb=dBassGain;
    bassV=(pow(10,dBassGain*0.05)-1)*100;
    bassV=min(600,max(0,bassV));
    bass_requested=bassV*0.009999999776482582;
);
abs(bass_factor-bass_requested)>0.10000000149011612 ? (
    // Native G rounding is float32 before converting to integer.
    bass_factor=floor(bass_requested*16777216+0.5)/16777216;
    coeff_integer ? I_from_float(int_gain,bass_factor);
    Sub_coeff();
);
dBassMode!=prevBassMode ? (
    prevBassMode=dBassMode; Bass_reset();
);
Bass_process();

(dClarityMode == 0) ? (
    ns_diffL = (spl0 - ns_inL) * clarityAmount;
    ns_inL   = spl0;
    ns_sL    = spl0 + ns_diffL;
    ns_hL    = ns_sL * ns_b1;
    ns_outL  = ns_prevL + ns_sL * ns_b0;
    ns_prevL = ns_outL * ns_a1 + ns_hL;

    ns_diffR = (spl1 - ns_inR) * clarityAmount;
    ns_inR   = spl1;
    ns_sR    = spl1 + ns_diffR;
    ns_hR    = ns_sR * ns_b1;
    ns_outR  = ns_prevR + ns_sR * ns_b0;
    ns_prevR = ns_outR * ns_a1 + ns_hR;

    spl0 = ns_outL;
    spl1 = ns_outR;

) : (dClarityMode == 1) ? (
    dStrength != prev_dStrength ? (
        HS_Calc(8250.0, clarityAmount + 1.0);
        prev_dStrength = dStrength;
    );

    hs_oL  = (hs_x1L * hs_b1c + spl0 * hs_b0c + hs_b2c * hs_x2L
              - hs_y1L * hs_a1c - hs_a2c * hs_y2L) * hs_a0i;
    hs_y2L = hs_y1L; hs_y1L = hs_oL;
    hs_x2L = hs_x1L; hs_x1L = spl0;

    hs_oR  = (hs_x1R * hs_b1c + spl1 * hs_b0c + hs_b2c * hs_x2R
              - hs_y1R * hs_a1c - hs_a2c * hs_y2R) * hs_a0i;
    hs_y2R = hs_y1R; hs_y1R = hs_oR;
    hs_x2R = hs_x1R; hs_x1R = spl1;

    spl0 = hs_oL;
    spl1 = hs_oR;

) : (
    xh_gain = clarityAmount + 1.0;

    xh_h     = spl0 * xh_lp_b1;
    xh_lpL   = xh_lp_pL + spl0 * xh_lp_b0;
    xh_lp_pL = xh_lpL * xh_lp_a1 + xh_h;

    xh_h      = spl0 * xh_hp_b1;
    xh_v      = xh_hp1_pL + spl0 * xh_hp_b0;
    xh_hp1_pL = xh_v * xh_hp_a1 + xh_h;
    xh_h      = xh_v * xh_hp_b1;
    xh_v2     = xh_hp2_pL + xh_v * xh_hp_b0;
    xh_hp2_pL = xh_v2 * xh_hp_a1 + xh_h;
    xh_h      = xh_v2 * xh_hp_b1;
    xh_hpL    = xh_hp3_pL + xh_v2 * xh_hp_b0;
    xh_hp3_pL = xh_hpL * xh_hp_a1 + xh_h;

    xh_h        = spl0 * xh_bplp_b1;
    xh_v        = xh_bplp1_pL + spl0 * xh_bplp_b0;
    xh_bplp1_pL = xh_v * xh_bplp_a1 + xh_h;
    xh_h        = xh_v * xh_bplp_b1;
    xh_v2       = xh_bplp2_pL + xh_v * xh_bplp_b0;
    xh_bplp2_pL = xh_v2 * xh_bplp_a1 + xh_h;
    xh_h        = xh_v2 * xh_bplp_b1;
    xh_v3       = xh_bplp3_pL + xh_v2 * xh_bplp_b0;
    xh_bplp3_pL = xh_v3 * xh_bplp_a1 + xh_h;
    xh_h        = xh_v3 * xh_bphp_b1;
    xh_v        = xh_bphp1_pL + xh_v3 * xh_bphp_b0;
    xh_bphp1_pL = xh_v * xh_bphp_a1 + xh_h;
    xh_h        = xh_v * xh_bphp_b1;
    xh_v2       = xh_bphp2_pL + xh_v * xh_bphp_b0;
    xh_bphp2_pL = xh_v2 * xh_bphp_a1 + xh_h;
    xh_h        = xh_v2 * xh_bphp_b1;
    xh_bpL      = xh_bphp3_pL + xh_v2 * xh_bphp_b0;
    xh_bphp3_pL = xh_bpL * xh_bphp_a1 + xh_h;

    xh_lpDly = xh_lpDL[xh_lpPos];
    xh_lpDL[xh_lpPos] = xh_lpL;
    xh_lpPos = (xh_lpPos + 1) % xh_lpDlyLen;

    xh_bpDly = xh_bpDL[xh_bpPos];
    xh_bpDL[xh_bpPos] = xh_bpL;
    xh_bpPos = (xh_bpPos + 1) % xh_bpDlyLen;

    spl0 = xh_hpL * xh_gain * 1.2 + xh_bpDly * xh_gain + xh_lpDly;

    xh_h     = spl1 * xh_lp_b1;
    xh_lpR   = xh_lp_pR + spl1 * xh_lp_b0;
    xh_lp_pR = xh_lpR * xh_lp_a1 + xh_h;

    xh_h      = spl1 * xh_hp_b1;
    xh_v      = xh_hp1_pR + spl1 * xh_hp_b0;
    xh_hp1_pR = xh_v * xh_hp_a1 + xh_h;
    xh_h      = xh_v * xh_hp_b1;
    xh_v2     = xh_hp2_pR + xh_v * xh_hp_b0;
    xh_hp2_pR = xh_v2 * xh_hp_a1 + xh_h;
    xh_h      = xh_v2 * xh_hp_b1;
    xh_hpR    = xh_hp3_pR + xh_v2 * xh_hp_b0;
    xh_hp3_pR = xh_hpR * xh_hp_a1 + xh_h;

    xh_h        = spl1 * xh_bplp_b1;
    xh_v        = xh_bplp1_pR + spl1 * xh_bplp_b0;
    xh_bplp1_pR = xh_v * xh_bplp_a1 + xh_h;
    xh_h        = xh_v * xh_bplp_b1;
    xh_v2       = xh_bplp2_pR + xh_v * xh_bplp_b0;
    xh_bplp2_pR = xh_v2 * xh_bplp_a1 + xh_h;
    xh_h        = xh_v2 * xh_bplp_b1;
    xh_v3       = xh_bplp3_pR + xh_v2 * xh_bplp_b0;
    xh_bplp3_pR = xh_v3 * xh_bplp_a1 + xh_h;
    xh_h        = xh_v3 * xh_bphp_b1;
    xh_v        = xh_bphp1_pR + xh_v3 * xh_bphp_b0;
    xh_bphp1_pR = xh_v * xh_bphp_a1 + xh_h;
    xh_h        = xh_v * xh_bphp_b1;
    xh_v2       = xh_bphp2_pR + xh_v * xh_bphp_b0;
    xh_bphp2_pR = xh_v2 * xh_bphp_a1 + xh_h;
    xh_h        = xh_v2 * xh_bphp_b1;
    xh_bpR      = xh_bphp3_pR + xh_v2 * xh_bphp_b0;
    xh_bphp3_pR = xh_bpR * xh_bphp_a1 + xh_h;

    xh_lpDlyR = xh_lpDR[xh_lpPos];
    xh_lpDR[xh_lpPos] = xh_lpR;
    xh_lpPos = (xh_lpPos + 1) % xh_lpDlyLen;

    xh_bpDlyR = xh_bpDR[xh_bpPos];
    xh_bpDR[xh_bpPos] = xh_bpR;
    xh_bpPos = (xh_bpPos + 1) % xh_bpDlyLen;

    spl1 = xh_hpR * xh_gain * 1.2 + xh_bpDlyR * xh_gain + xh_lpDlyR;
);

desc: ViPER Bass + clarity (iemu)
author: VipersAudio
tags: clarity treble presence enhance viper bass subwoofer
//integer emulation version

dClarityMode:0<0,2,1{Natural,Ozone,xHiFi}>Clarity mode
dStrength:3.5<0,14.8,0.1>Clarity gain (dB)
dBassMode:0<0,2,1{Natural Bass,Pure Bass+,Subwoofer}>Bass mode
dFrequency:40<0,100,1>Bass frequency (Hz)
dBassGain:3.5<3.5,17,0.1>Bass gain (dB)

@init
dClarityMode=0;
dStrength=3.5;
dBassMode=0;
dFrequency=40;
dBassGain=3.5;

prevStrengthDb=-99999;
prevBassDb=-99999;
clarityAmount=0;
bass_requested=0;
clarityV=0;
bassV=0;

ns_freq = srate * 0.5 - 1000.0;
ns_t    = tan($PI * ns_freq / srate);
ns_b0   = ns_t / (1.0 + ns_t);
ns_b1   = ns_b0;
ns_a1   = (1.0 - ns_t) / (1.0 + ns_t);

ns_prevL = 0.0;  ns_prevR = 0.0;
ns_inL   = 0.0;  ns_inR   = 0.0;

function HS_Calc(freq_hz gain_lin) (
    hs_dBg  = 20.0 * log10(gain_lin);
    hs_x    = 2.0 * $PI * freq_hz / srate;
    hs_sinx = sin(hs_x);
    hs_cosx = cos(hs_x);
    hs_y    = exp(hs_dBg * log(10.0) / 40.0);
    hs_z    = sqrt(hs_y * 2.0) * hs_sinx;
    hs_aa   = (hs_y - 1.0) * hs_cosx;
    hs_b    = (hs_y + 1.0) - hs_aa;
    hs_c    = hs_z + hs_b;
    hs_d    = (hs_y + 1.0) * hs_cosx;
    hs_e    = (hs_y + 1.0) + hs_aa;
    hs_ff   = (hs_y - 1.0) - hs_d;
    hs_a0i  = 1.0 / hs_c;
    hs_a1c  = hs_ff * 2.0;
    hs_a2c  = hs_b - hs_z;
    hs_b0c  = (hs_e + hs_z) * hs_y;
    hs_b1c  = -hs_y * 2.0 * ((hs_y - 1.0) + hs_d);
    hs_b2c  = (hs_e - hs_z) * hs_y;
);

HS_Calc(8250.0, dStrength + 1.0);

hs_x1L = 0.0; hs_x2L = 0.0; hs_y1L = 0.0; hs_y2L = 0.0;
hs_x1R = 0.0; hs_x2R = 0.0; hs_y1R = 0.0; hs_y2R = 0.0;

prev_dStrength = -1;

xh_lp_t   = tan($PI * 120.0 / srate);
xh_lp_b0  = xh_lp_t / (1.0 + xh_lp_t);
xh_lp_b1  = xh_lp_b0;
xh_lp_a1  = (1.0 - xh_lp_t) / (1.0 + xh_lp_t);

xh_hp_t   = tan($PI * 1200.0 / srate);
xh_hp_b0  =  1.0 / (1.0 + xh_hp_t);
xh_hp_b1  = -xh_hp_b0;
xh_hp_a1  = (1.0 - xh_hp_t) / (1.0 + xh_hp_t);

xh_bplp_t  = tan($PI * 1200.0 / srate);
xh_bplp_b0 = xh_bplp_t / (1.0 + xh_bplp_t);
xh_bplp_b1 = xh_bplp_b0;
xh_bplp_a1 = (1.0 - xh_bplp_t) / (1.0 + xh_bplp_t);

xh_bphp_t  = tan($PI * 120.0 / srate);
xh_bphp_b0 =  1.0 / (1.0 + xh_bphp_t);
xh_bphp_b1 = -xh_bphp_b0;
xh_bphp_a1 = (1.0 - xh_bphp_t) / (1.0 + xh_bphp_t);

xh_lp_pL  = 0.0; xh_lp_pR  = 0.0;
xh_hp1_pL = 0.0; xh_hp1_pR = 0.0;
xh_hp2_pL = 0.0; xh_hp2_pR = 0.0;
xh_hp3_pL = 0.0; xh_hp3_pR = 0.0;
xh_bplp1_pL = 0.0; xh_bplp1_pR = 0.0;
xh_bplp2_pL = 0.0; xh_bplp2_pR = 0.0;
xh_bplp3_pL = 0.0; xh_bplp3_pR = 0.0;
xh_bphp1_pL = 0.0; xh_bphp1_pR = 0.0;
xh_bphp2_pL = 0.0; xh_bphp2_pR = 0.0;
xh_bphp3_pL = 0.0; xh_bphp3_pR = 0.0;

xh_bpDlyLen = floor(srate / 400);
xh_lpDlyLen = floor(srate / 200);

// JamesDSP uses binary32 variables. High-precision handles are used ONLY
// during coefficient setup, then deleted. Steady-state processing never allocates.
function H_keep(h) ( hp_temp[hp_count] = h; hp_count += 1; h; );
function H_f(v) ( H_keep(xFloatF(v)); );
function H_s(v) ( H_keep(xFloatS(v)); );
function H_add(a b) ( H_keep(xAdd(a,b)); );
function H_sub(a b) ( H_keep(xSub(a,b)); );
function H_mul(a b) ( H_keep(xMul(a,b)); );
function H_div(a b) ( H_keep(xDiv(a,b)); );
function H_neg(a) ( H_keep(xNegation(a)); );
function H_floor(a) ( H_keep(xfloor(a)); );
function H_trunc(a) ( H_keep(xtrunc(a)); );
function H_abs(a) ( H_keep(xabs(a)); );
function H_pow(a b) ( H_keep(xpow(a,b)); );
function H_two(e) ( H_keep(xMulPowOf2($hOne,e<0 ? e-0.0001 : e)); );
// IEEE round-to-nearest, ties-to-even, to p significant binary digits.
// Used for binary64 designer operations and binary32 conversions. Parameters
// remain in the normal range for the supported sample rates and controls.
function H_round(a p) local(e step scaled mag whole frac odd rounded) (
    xequal(a,$hZero) ? a : (
        e = xbinexp(a);
        step = H_two(e-p+1);
        scaled = H_div(H_abs(a),step);
        whole = H_floor(scaled);
        frac = H_sub(scaled,whole);
        odd = xF2f32(H_sub(whole,H_mul(H_floor(H_div(whole,$hTwo)),$hTwo)));
        rounded = whole;
        xgreater(frac,hp_half) || (xequal(frac,hp_half) && odd) ? rounded=H_add(whole,$hOne);
        mag = H_mul(rounded,step);
        xless(a,$hZero) ? H_neg(mag) : mag;
    );
);
function D_add(a b) ( H_round(H_add(a,b),53); );
function D_sub(a b) ( H_round(H_sub(a,b),53); );
function D_mul(a b) ( H_round(H_mul(a,b),53); );
function D_div(a b) ( H_round(H_div(a,b),53); );
function H_float(a) ( xF2f32(H_round(a,24)); );
function H_cleanup() local(i) (
    i=0; loop(hp_count, DeleteSysVariable(hp_temp[i]); i+=1;);
    hp_count=0;
);
// Split exact signed int32 coefficient into four base-256 digits. No large
// integer is ever converted to a float32. High digit is unsigned two's complement.
function H_store_int(dst a) local(v q i digit) (
    v=H_trunc(a);
    i=0; loop(4,
        q=H_floor(H_div(v,hp_256));
        digit=H_sub(v,H_mul(q,hp_256));
        dst[i]=xF2f32(digit); v=q; i+=1;
    );
);
function Coeff_store(dst b0 b1 b2 p1 p2) (
    coeff_integer ? (
        H_store_int(dst,b0); H_store_int(dst+4,b1); H_store_int(dst+8,b2);
        H_store_int(dst+12,p1); H_store_int(dst+16,p2);
    ) : (
        dst[0]=H_float(H_div(b0,hp_scale)); dst[1]=H_float(H_div(b1,hp_scale));
        dst[2]=H_float(H_div(b2,hp_scale)); dst[3]=H_float(H_div(p1,hp_scale));
        dst[4]=H_float(H_div(p2,hp_scale));
    );
);
function Fixed_coeff(freq sr) local(w sn cs alpha a0 a1 a2 b0 b1 inv r0 r1 r2 r3 r4) (
    w=(freq*6.2831854820251465)/sr;
    sn=sin(w); cs=cos(w); alpha=sn/(0.5299999713897705+0.5299999713897705);
    a0=1+alpha; a1=-2*cs; a2=1-alpha; b1=1-cs; b0=0.5*b1; inv=1/a0;
    // Float version uses the designer's unquantized coefficients.
    coeff_integer ? (
        r0=H_trunc(H_add(H_mul(H_f(b0*inv),hp_scale),hp_half));
        r1=H_trunc(H_add(H_mul(H_f(b1*inv),hp_scale),hp_half));
        r2=r0;
        r3=H_neg(H_trunc(H_add(H_mul(H_f(a1*inv),hp_scale),hp_half)));
        r4=H_neg(H_trunc(H_add(H_mul(H_f(a2*inv),hp_scale),hp_half)));
        Coeff_store(bass_lp,r0,r1,r2,r3,r4);
    ) : (
        bass_lp[0]=b0*inv; bass_lp[1]=b1*inv; bass_lp[2]=b0*inv;
        bass_lp[3]=-a1*inv; bass_lp[4]=-a2*inv;
    );
    H_cleanup();
);
function Multi_coeff(dst freq sr width db peak) local(w sn cs alpha amp a0 a1 a2 b0 b1 b2 inv r0 r1 r2 r3 r4 t) (
    w=D_div(D_mul(H_f(freq),hp_pi2),H_f(sr));
    sn=H_round(H_keep(xsin(w)),53); cs=H_round(H_keep(xcos(w)),53);
    peak ? (
        amp=H_round(H_pow(hp_ten,D_mul(H_f(db),hp_025)),53);
        t=D_div(D_mul(w,D_mul(H_f(width),hp_ln2half)),sn);
        alpha=D_mul(H_round(H_keep(xsinh(t)),53),sn);
        t=D_div(alpha,amp); a0=D_add(t,$hOne); a2=D_sub($hOne,t);
        t=D_mul(alpha,amp); b0=D_add(t,$hOne); b2=D_sub($hOne,t);
        b1=D_mul(cs,hp_minus2);
    ) : (
        alpha=D_div(sn,D_add(H_f(width),H_f(width)));
        a0=D_add(alpha,$hOne); a2=D_sub($hOne,alpha);
        b1=D_sub($hOne,cs); b0=D_mul(b1,hp_half); b2=b0;
    );
    a1=D_mul(cs,hp_minus2); inv=D_div($hOne,a0);
    coeff_integer ? (
        r0=H_trunc(D_add(D_mul(D_div(b0,a0),hp_scale),hp_half));
        r1=H_trunc(D_add(D_mul(D_mul(b1,hp_scale),inv),hp_half));
        r2=H_trunc(D_add(D_mul(D_div(b2,a0),hp_scale),hp_half));
        r3=H_trunc(D_add(D_mul(D_mul(H_neg(a1),inv),hp_scale),hp_half));
        r4=H_trunc(D_add(D_mul(D_mul(H_neg(a2),inv),hp_scale),hp_half));
        Coeff_store(dst,r0,r1,r2,r3,r4);
    ) : (
        dst[0]=H_float(D_div(b0,a0)); dst[1]=H_float(D_div(b1,a0));
        dst[2]=H_float(D_div(b2,a0)); dst[3]=H_float(D_div(H_neg(a1),a0));
        dst[4]=H_float(D_div(H_neg(a2),a0));
    );
    H_cleanup();
);
function Sub_coeff() local(a d1 d2 h) (
    a=bass_factor*2.5;
    a>0.0001 ? (
        h=H_round(H_keep(xlog10(H_f(a))),53);
        d1=H_float(D_mul(h,hp_twenty));
        h=H_round(H_keep(xlog10(H_f(a*0.125))),53);
        d2=H_float(D_mul(h,hp_twenty));
    ) : (d1=0; d2=0;);
    H_cleanup();
    Multi_coeff(bass_p44,44,srate,0.75,d1,1);
    Multi_coeff(bass_p80,80,srate,0.2,d2,1);
    Multi_coeff(bass_swlp,380,srate,0.6,0,0);
    memset(bass_sub_state,0,sub_state_size);
);
function Bass_coeff_init() (
    hp_count=0;
    hp_half=xFloatF(0.5); hp_256=xFloatF(256); hp_scale=xFloatF(16777216);
    hp_ten=xFloatF(10); hp_twenty=xFloatF(20); hp_minus2=xFloatF(-2);
    hp_pi2=xFloatS("6.283185307179586232");
    hp_025=xFloatS("0.025000000000000001388");
    hp_ln2half=xFloatS("0.34657359027997264311");
);

coeff_integer=1; sub_state_size=96;
bass_lp=0; bass_p44=20; bass_p80=40; bass_swlp=60;
bass_lp_state=80; bass_sub_state=96;
bass_taps=192; bass_firL=448; bass_firR=704; bass_delay=960;
int_acc=1216; int_L=1224; int_R=1228; int_U=1232; int_m=1236;
int_v=1240; int_dl=1244; int_fl=1248; int_fr=1252;
